# Ignore these files in exports
/.editorconfig export-ignore
/.gitattributes export-ignore
/.github export-ignore
/.gitignore export-ignore
/.phpstorm.meta.php export-ignore
/.stylelintrc export-ignore
/.travis.yml export-ignore
/.tx export-ignore
/bin export-ignore
/codecov.yml export-ignore
/phpcs.ruleset.xml export-ignore
/phpunit.xml export-ignore
/tests export-ignore
/webpack.mix.js export-ignore
/yarn.lock export-ignore

# Normalize line endings — LF in repo, platform-native in working dir
* text=auto

# Use LF consistently for common config and code files
*.js    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.scss  text eol=lf
*.md    text eol=lf
*.sh    text eol=lf

# Binary files (no line ending conversion)
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.woff binary
*.woff2 binary
*.ttf binary
*.otf binary