#, php-format
msgid ""
"Pressbooks could not create the mu-plugins folder. Please create the "
"following directory: %s"
msgstr ""
"ಪ್ರೆಸ್‍ಬುಕ್ಸ್ ಮು-ಪ್ಲಗಿನ್ ಫೋಲ್ಡರ್ ಅನ್ನು ರಚಿಸಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಈ ಕೆಳಗಿನ "
"ಡೈರೆಕ್ಟರಿಯನ್ನು ರಚಿಸಿ: %s"

#, php-format
msgid ""
"Pressbooks could not copy the autoloader from %1$s to %2$s. Please copy the "
"file manually."
msgstr ""
"ಪ್ರೆಸ್‍ಬುಕ್ಸ್ ಆಟೋಲೋಡರ್ ಅನ್ನು %1$s ನಿಂದ %2$s ನಕಲು ಮಾಡಲು ಸಾಧ್ಯವಾಗಲಿಲ್ಲ. ದಯವಿಟ್ಟು ಫೈಲ್ "
"ಅನ್ನು ಹಸ್ತಚಾಲಿತವಾಗಿ ನಕಲಿಸಿ."

#, php-format
msgid ""
"Pressbooks will not work with your version of PHP. Pressbooks requires PHP "
"version %s or greater. Please upgrade PHP if you would like to use "
"Pressbooks."
msgstr ""
"ನಿಮ್ಮ ಪಿಎಚ್‍ಪಿ ಆವೃತ್ತಿಯೊಂದಿಗೆ ಪ್ರೆಸ್ ಬುಕ್ ಗಳು ಕೆಲಸ ಮಾಡುವುದಿಲ್ಲ. ಪ್ಪ್ರೆಸ್‍ಬುಕ್ಸ್ ಪಿಎಚ್‍ಪಿ "
"ಆವೃತ್ತಿಯು %s ಅಥವಾ ಅದಕ್ಕಿಂತ ಹೆಚ್ಚಿನದಕ್ಕೆ ಅಗತ್ಯವಿದೆ. ನೀವು ಪ್ರೆಸ್‍ಬುಕ್ಸ್ ಬಳಸಲು ಬಯಸಿದರೆ "
"ದಯವಿಟ್ಟು ಪಿಎಚ್‍ಪಿಯನ್ನು ನವೀಕರಿಸಿ."

#, php-format
msgid ""
"Pressbooks will not work with your version of WordPress. Pressbooks requires "
"a dedicated install of WordPress Multisite, version %s or greater. Please "
"upgrade WordPress if you would like to use Pressbooks."
msgstr ""
"ನಿಮ್ಮ ವರ್ಡ್ಪ್ರೆಸ್ ಆವೃತ್ತಿಯೊಂದಿಗೆ ಪ್ಪ್ರೆಸ್‍ಬುಕ್ಸ್ ಕೆಲಸ ಮಾಡುವುದಿಲ್ಲ. ಪ್ರೆಸ್ ಬುಕ್ ಗಳಿಗೆ ವರ್ಡ್ಪ್ರೆಸ್ "
"ಮಲ್ಟಿಸೈಟ್, ಆವೃತ್ತಿ %s ಅಥವಾ ಅದಕ್ಕಿಂತ ಹೆಚ್ಚಿನಮೀಸಲಾದ ಸ್ಥಾಪನೆಯ ಅಗತ್ಯವಿದೆ. ನೀವು ಪ್ರೆಸ್ ಬುಕ್ "
"ಗಳನ್ನು ಬಳಸಲು ಬಯಸಿದರೆ ದಯವಿಟ್ಟು ವರ್ಡ್ಪ್ರೆಸ್ ಅನ್ನು ನವೀಕರಿಸಿ."

msgid ""
"The Pressbooks plugin is inactive, but you have active plugins that require "
"Pressbooks. This is causing errors. Please go to the Plugins page, and "
"activate Pressbooks."
msgstr ""
"ಪ್ರೆಸ್‍ಬುಕ್ಸ್ ಪ್ಲಗ್ ಇನ್ ನಿಷ್ಕ್ರಿಯವಾಗಿದೆ, ಆದರೆ ಪ್ರೆಸ್ ಬುಕ್ ಗಳ ಅಗತ್ಯವಿರುವ ಸಕ್ರಿಯ ಪ್ಲಗಿನ್ ಗಳನ್ನು "
"ನೀವು ಹೊಂದಿದ್ದೀರಿ. ಇದರಿಂದ ದೋಷಗಳು ಉಂಟಾಗುತ್ತವೆ. ದಯವಿಟ್ಟು ಪ್ಲಗಿನ್ಸ್ ಪುಟಕ್ಕೆ ಹೋಗಿ, ಮತ್ತು "
"ಪ್ಪ್ರೆಸ್‍ಬುಕ್ಸ್ ಸಕ್ರಿಯಗೊಳಿಸಿ."

