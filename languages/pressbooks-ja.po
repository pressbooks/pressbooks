msgstr "テーマを変更"

#: inc/admin/covergenerator/namespace.php:460
msgid "Options"
msgstr "オプション"

#: inc/admin/covergenerator/namespace.php:463
msgid "You can upload a background image here."
msgstr "ここに背景画像をアップロードできます。"

#. translators: 1: minimum width, 2: minimum height, 3: aspect ratio width, 4:
#. aspect ratio height
#: inc/admin/covergenerator/namespace.php:500
#, php-format
